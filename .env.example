# ==== MediRemind environment configuration ====
# Copy to server/.env and fill in real values. NEVER commit real secrets.

# --- Database ---
# Prisma reads the datasource provider from the schema file:
#   server/prisma/schema.prisma          -> sqlite     (development)
#   server/prisma/schema.postgres.prisma -> postgresql (production)

# DEVELOPMENT: SQLite file database.
DATABASE_URL="file:./dev.db"

# PRODUCTION: use the Postgres schema and a connection string like:
# DATABASE_URL="postgresql://user:password@host:5432/mediremind?sslmode=require"
# (deploy runs `npm run db:push:postgres` to provision it)

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Sessions ---
# Change this to a long random string in production (e.g. openssl rand -hex 32).
SESSION_SECRET="dev-only-change-me-to-a-long-random-string"

# --- CORS ---
# Comma-separated list of allowed origins (the Vite dev server by default).
CORS_ORIGIN="http://localhost:5173"

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
