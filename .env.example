# ==== MediRemind environment configuration ====
# Copy to server/.env and fill in real values. NEVER commit real secrets.

# --- Database ---
# DEVELOPMENT (current default): SQLite file database.
DATABASE_URL="file:./dev.db"

# PRODUCTION: switch Prisma provider to "postgresql" in server/prisma/schema.prisma
# and use a connection string like:
# DATABASE_URL="postgresql://user:password@host:5432/mediremind?schema=public"

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Sessions ---
# Change this to a long random string in production (e.g. openssl rand -hex 32).
SESSION_SECRET="dev-only-change-me-to-a-long-random-string"

# --- CORS ---
# Comma-separated list of allowed origins (the Vite dev server by default).
CORS_ORIGIN="http://localhost:5173"

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
