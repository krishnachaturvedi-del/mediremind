# Copy to `.env` and adjust for your environment.
#
# Development (SQLite) — this is what the checked-in server/.env uses:
DATABASE_URL="file:./dev.db"
PORT=3001
NODE_ENV=development
SESSION_SECRET="change-me-to-a-long-random-string"
CORS_ORIGIN="http://localhost:5173,http://localhost:4173"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Production (PostgreSQL) — also change `provider` in prisma/schema.prisma
# to "postgresql", then run `npx prisma db push`:
# DATABASE_URL="postgresql://user:password@host:5432/mediremind?schema=public"
# NODE_ENV=production
# SESSION_SECRET="<64+ random bytes>"
# CORS_ORIGIN="https://your-domain.example"
